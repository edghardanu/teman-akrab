{
  "name": "absensi-pengajian-teman-akrab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply absensi-pengajian --local",
    "db:migrate:remote": "wrangler d1 migrations apply absensi-pengajian --remote",
    "db:seed:local": "wrangler d1 execute absensi-pengajian --local --file=scripts/seed-villages.sql",
    "db:seed-admin:local": "node scripts/seed-admin.mjs --local",
    "db:seed-admin:remote": "node scripts/seed-admin.mjs --remote"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@opennextjs/cloudflare": "1.20.9",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.62.0",
    "recharts": "^3.2.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "wrangler": "^4.39.0"
  }
}
